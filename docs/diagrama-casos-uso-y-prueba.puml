@startuml
title LessionAngel - Casos de uso y pruebas de aceptación
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho

actor "Deportista" as User
actor "ESP32 LESSION\n(periférico BLE)" as Sensor

rectangle "LessionAngel" {
  usecase "UC01\nBuscar ESP32 por BLE" as UC01
  usecase "UC02\nSeleccionar placa detectada" as UC02
  usecase "UC03\nConectar por GATT y\nactivar notificaciones EMG" as UC03
  usecase "UC04\nRecibir muestra\n(tiempo, ADC)" as UC04
  usecase "UC05\nIniciar sesión\nde entrenamiento" as UC05
  usecase "UC06\nVer señal EMG\nen tiempo real" as UC06
  usecase "UC07\nDetener captura" as UC07
  usecase "UC08\nGuardar sesión y\nconsultar análisis" as UC08
  usecase "UC09\nConsultar sesiones\nguardadas" as UC09
  usecase "UC10\nExportar una sesión\na CSV" as UC10
  usecase "UC11\nIniciar otra sesión" as UC11
  usecase "UC12\nBorrar sesión actual" as UC12
  usecase "UC13\nVolver a la pantalla anterior" as UC13
  usecase "UC14\nSalir de la aplicación" as UC14
}

User --> UC01
User --> UC02
User --> UC03
User --> UC05
User --> UC06
User --> UC07
User --> UC08
User --> UC09
User --> UC10
User --> UC11
User --> UC12
User --> UC13
User --> UC14
Sensor --> UC03
Sensor --> UC04

UC03 ..> UC01 : <<include>>
UC03 ..> UC02 : <<include>>
UC06 ..> UC04 : <<include>>
UC05 ..> UC06 : <<include>>
UC08 ..> UC05 : <<extend>>
UC10 ..> UC09 : <<extend>>
UC11 ..> UC08 : <<extend>>
UC12 ..> UC08 : <<extend>>

note bottom of UC04
  El firmware envía texto ASCII
  t_ms,adc seguido de LF por TX.
  ADC es una cuenta de 0 a 4095;
  no representa pulso ni fuerza.
end note

package "Pruebas de aceptación — detalle en docs/casos-de-uso-y-pruebas.md" {
  usecase "TC01–TC05\nBuscar y conectar BLE" as TC1 <<test>>
  usecase "TC06–TC08\nValidar y mostrar muestras EMG" as TC2 <<test>>
  usecase "TC09–TC13\nGrabar, detener y guardar sesiones" as TC3 <<test>>
  usecase "TC14–TC19\nHistorial, CSV y navegación" as TC4 <<test>>
}
TC1 ..> UC01 : <<verifica>>
TC1 ..> UC03 : <<verifica>>
TC2 ..> UC04 : <<verifica>>
TC2 ..> UC06 : <<verifica>>
TC3 ..> UC05 : <<verifica>>
TC3 ..> UC07 : <<verifica>>
TC3 ..> UC08 : <<verifica>>
TC4 ..> UC09 : <<verifica>>
TC4 ..> UC10 : <<verifica>>
TC4 ..> UC11 : <<verifica>>
TC4 ..> UC12 : <<verifica>>
TC4 ..> UC13 : <<verifica>>
TC4 ..> UC14 : <<verifica>>
@enduml
